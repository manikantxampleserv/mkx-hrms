generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Role {
  id               Int              @id @default(autoincrement())
  name             String           @unique @db.VarChar(50)
  description      String?
  status           String           @default("Active") @db.VarChar(50)
  created_at       DateTime         @default(now())
  updated_at       DateTime         @default(now()) @updatedAt

  users            User[]
  employees        Employee[]
  role_permissions RolePermission[]

  @@map("roles")
}

model Permission {
  id               Int              @id @default(autoincrement())
  name             String           @unique @db.VarChar(100)
  module           String           @db.VarChar(50)
  description      String?
  created_at       DateTime         @default(now())

  role_permissions RolePermission[]

  @@map("permissions")
}

model RolePermission {
  role_id       Int
  permission_id Int

  role          Role       @relation(fields: [role_id], references: [id], onDelete: Cascade)
  permission    Permission @relation(fields: [permission_id], references: [id], onDelete: Cascade)

  @@id([role_id, permission_id])
  @@map("role_permissions")
}

model Department {
  id           Int           @id @default(autoincrement())
  name         String        @unique @db.VarChar(100)
  code         String?       @db.VarChar(50)
  description  String?
  status       String        @default("Active") @db.VarChar(50)
  created_at   DateTime      @default(now())
  updated_at   DateTime      @updatedAt

  employees    Employee[]
  designations Designation[]

  @@map("departments")
}

model User {
  id                       Int                      @id @default(autoincrement())
  employee_id              String                   @unique @db.VarChar(50)
  first_name               String                   @db.VarChar(100)
  last_name                String                   @db.VarChar(100)
  email                    String                   @unique @db.VarChar(255)
  password_hash            String?                  @db.VarChar(255)
  role_id                  Int?
  status                   String?                  @default("active") @db.VarChar(20)
  avatar                   String?                  @db.Text
  timezone                 String?                  @default("UTC (GMT+00:00)") @db.VarChar(100)
  password_reset_token     String?                  @unique @db.VarChar(128)
  password_reset_expires   DateTime?
  created_at               DateTime                 @default(now())
  updated_at               DateTime                 @updatedAt

  role                     Role?                    @relation(fields: [role_id], references: [id], onDelete: SetNull)
  employee                 Employee?
  notification_preferences NotificationPreference[]
  activity_logs            ActivityLog[]
  blogs                    BlogPost[]

  @@map("users")
}

model Employee {
  id             Int           @id @default(autoincrement())
  employee_id    String        @unique @db.VarChar(50)
  name           String        @db.VarChar(200)
  first_name     String?       @db.VarChar(100)
  last_name      String?       @db.VarChar(100)
  email          String        @unique @db.VarChar(255)
  role_id        Int?
  department_id  Int?
  status         String        @default("Active") @db.VarChar(50)
  manager_id     Int?
  join_date      DateTime      @db.Date
  birth_date     DateTime?     @db.Date
  address        String?       @db.Text
  phone          String?       @db.VarChar(50)
  avatar         String?       @db.Text
  user_id        Int?          @unique
  created_at     DateTime      @default(now())
  updated_at     DateTime      @updatedAt

  user                     User?                    @relation(fields: [user_id], references: [id], onDelete: Cascade)
  role_rel                 Role?                    @relation(fields: [role_id], references: [id], onDelete: SetNull)
  department_rel           Department?              @relation(fields: [department_id], references: [id], onDelete: SetNull)
  manager                  Employee?                @relation("EmployeeManager", fields: [manager_id], references: [id], onDelete: SetNull)
  subordinates             Employee[]               @relation("EmployeeManager")

  attendance               Attendance[]
  leaves                   Leave[]
  payrolls                 Payroll[]
  activity_logs            ActivityLog[]
  notification_preferences NotificationPreference[]
  candidate                Candidate?

  @@map("employees")
}

model Attendance {
  id          Int      @id @default(autoincrement())
  record_id   String   @unique @db.VarChar(50)
  employee_id Int
  date        DateTime @default(now()) @db.Date
  check_in    String?  @db.VarChar(50)
  check_out   String?  @db.VarChar(50)
  work_hours  String?  @db.VarChar(50)
  status      String   @db.VarChar(50)
  location    String   @db.VarChar(100)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  employee    Employee @relation(fields: [employee_id], references: [id], onDelete: Cascade)

  @@map("attendance")
}

model Leave {
  id          Int      @id @default(autoincrement())
  leave_code  String   @unique @db.VarChar(50)
  employee_id Int
  leave_type  String   @db.VarChar(100)
  start_date  DateTime @db.Date
  end_date    DateTime @db.Date
  days_count  Int
  reason      String   @db.Text
  status      String   @default("Pending") @db.VarChar(50)
  applied_on             DateTime  @default(now()) @db.Date
  approval_token         String?   @unique @db.VarChar(128)
  approval_token_expires DateTime?
  created_at             DateTime  @default(now())
  updated_at             DateTime  @updatedAt

  employee    Employee @relation(fields: [employee_id], references: [id], onDelete: Cascade)

  @@map("leaves")
}

model Payroll {
  id           Int      @id @default(autoincrement())
  payroll_code String   @unique @db.VarChar(50)
  employee_id  Int
  base_salary  Decimal  @db.Decimal(12, 2)
  allowance    Decimal  @default(0) @db.Decimal(12, 2)
  net_pay      Decimal  @db.Decimal(12, 2)
  status       String   @default("Pending") @db.VarChar(50)
  pay_date     DateTime @db.Date
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  employee     Employee @relation(fields: [employee_id], references: [id], onDelete: Cascade)

  @@map("payrolls")
}

model Candidate {
  id             Int      @id @default(autoincrement())
  candidate_code String   @unique @db.VarChar(50)
  name           String   @db.VarChar(150)
  email          String   @db.VarChar(255)
  position       String   @db.VarChar(100)
  department     String   @db.VarChar(100)
  stage          String   @default("Screening") @db.VarChar(50)
  experience     String   @db.VarChar(50)
  rating         Decimal? @db.Decimal(3, 1)
  status         String   @default("Active") @db.VarChar(50)
  applied_date   DateTime @default(now()) @db.Date
  avatar         String?  @db.Text
  onboarded_at   DateTime?
  employee_id    Int?      @unique
  created_at     DateTime  @default(now())
  updated_at     DateTime  @updatedAt

  employee       Employee? @relation(fields: [employee_id], references: [id], onDelete: SetNull)

  @@map("candidates")
}

model Report {
  id          Int      @id @default(autoincrement())
  report_code String   @unique @db.VarChar(50)
  title       String   @db.VarChar(255)
  category    String   @db.VarChar(100)
  date        DateTime @default(now()) @db.Date
  status      String   @default("generating") @db.VarChar(50)
  file_url    String?  @db.Text
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  @@map("reports")
}

model Integration {
  id          Int       @id @default(autoincrement())
  key         String    @unique @db.VarChar(50)
  name        String    @db.VarChar(100)
  description String    @db.VarChar(255)
  short_code  String    @db.VarChar(10)
  connected   Boolean   @default(false)
  last_sync   DateTime?
  created_at  DateTime  @default(now())
  updated_at  DateTime  @updatedAt

  @@map("integrations")
}

model NotificationPreference {
  id             Int       @id @default(autoincrement())
  user_id        Int?
  employee_id    Int?
  preference_key String    @db.VarChar(100)
  label          String?   @db.VarChar(150)
  description    String?   @db.VarChar(255)
  default_email  Boolean   @default(true)
  default_push   Boolean   @default(false)
  created_at     DateTime  @default(now())
  updated_at     DateTime  @updatedAt

  user           User?     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  employee       Employee? @relation(fields: [employee_id], references: [id], onDelete: Cascade)

  @@unique([user_id, preference_key])
  @@unique([employee_id, preference_key])
  @@map("notification_preferences")
}

model ActivityLog {
  id           Int       @id @default(autoincrement())
  user_id      Int?
  employee_id  Int?
  initials     String?   @db.VarChar(10)
  name         String    @db.VarChar(150)
  subtext      String    @db.VarChar(255)
  status_label String    @db.VarChar(50)
  status_type  String    @db.VarChar(50)
  bg_alpha     String?   @db.VarChar(50)
  created_at   DateTime  @default(now())

  user         User?     @relation(fields: [user_id], references: [id], onDelete: SetNull)
  employee     Employee? @relation(fields: [employee_id], references: [id], onDelete: SetNull)

  @@map("activity_logs")
}

model BlogPost {
  id           Int       @id @default(autoincrement())
  title        String    @db.VarChar(255)
  slug         String    @unique @db.VarChar(255)
  content      String    @db.Text
  excerpt      String?   @db.Text
  cover_image  String?   @db.Text
  category     String    @db.VarChar(100)
  tags         String[]  @default([])
  status       String    @default("Draft") @db.VarChar(50)
  author_name  String    @db.VarChar(150)
  author_id    Int?
  published_at DateTime?
  created_at   DateTime  @default(now())
  updated_at   DateTime  @updatedAt

  author       User?     @relation(fields: [author_id], references: [id], onDelete: SetNull)

  @@map("blogs")
}

model Designation {
  id            Int         @id @default(autoincrement())
  title         String      @unique @db.VarChar(100)
  code          String      @unique @db.VarChar(50)
  department_id Int?
  description   String?     @db.Text
  status        String      @default("Active") @db.VarChar(50)
  created_at    DateTime    @default(now())
  updated_at    DateTime    @updatedAt

  department    Department? @relation(fields: [department_id], references: [id], onDelete: SetNull)

  @@map("designations")
}

model LeaveType {
  id            Int      @id @default(autoincrement())
  name          String   @unique @db.VarChar(100)
  code          String   @unique @db.VarChar(50)
  days_per_year Int      @default(12)
  is_paid       Boolean  @default(true)
  color         String?  @default("#4f46e5") @db.VarChar(50)
  description   String?  @db.Text
  status        String   @default("Active") @db.VarChar(50)
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  @@map("leave_types")
}

model SalaryStructure {
  id                 Int      @id @default(autoincrement())
  name               String   @unique @db.VarChar(100)
  code               String   @unique @db.VarChar(50)
  description        String?  @db.Text
  basic_percentage   Decimal  @default(50.00) @db.Decimal(5, 2)
  hra_percentage     Decimal  @default(20.00) @db.Decimal(5, 2)
  da_percentage      Decimal  @default(10.00) @db.Decimal(5, 2)
  special_allowance  Decimal  @default(20.00) @db.Decimal(12, 2)
  pf_percentage      Decimal  @default(12.00) @db.Decimal(5, 2)
  tax_deduction_type String   @default("Standard") @db.VarChar(50)
  status             String   @default("Active") @db.VarChar(50)
  created_at         DateTime @default(now())
  updated_at         DateTime @updatedAt

  @@map("salary_structures")
}

model WorkShift {
  id          Int      @id @default(autoincrement())
  name        String   @unique @db.VarChar(100)
  code        String   @unique @db.VarChar(50)
  start_time  String   @db.VarChar(20)
  end_time    String   @db.VarChar(20)
  grace_mins  Int      @default(15)
  description String?  @db.Text
  status      String   @default("Active") @db.VarChar(50)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  @@map("work_shifts")
}

